# Open-source sanity synthesis (resource ESTIMATE only -- not a substitute for Vivado).
#   yosys -s syn/yosys.ys        (or: yowasp-yosys -s syn/yosys.ys)
read_verilog -sv rtl/mdp_fifo.sv rtl/mdp_hdr_parse.sv rtl/mdp_msg_asm.sv rtl/mdp_book.sv rtl/mdp_order_tx.sv rtl/mdp_top.sv
synth_xilinx -top mdp_top -family xc7 -flatten -noiopad
tee -o syn/out/yosys_stat.txt stat
